{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:js": "node tools/run_js_tests.mjs",
        "test:ci": "node tools/run_js_tests.mjs",
        "validate:ui-layers": "node tools/validate_ui_layers.mjs",
        "validate:phase3": "node tools/validate_phase3.mjs",
        "validate:phase4": "node tools/validate_phase4.mjs",
        "validate:phase5": "node tools/validate_phase5.mjs",
        "validate:phase6": "node tools/validate_phase6.mjs",
        "validate:phase7": "node tools/validate_phase7.mjs",
        "validate:phase8": "node tools/validate_phase8.mjs",
        "validate:phase10": "node tools/validate_phase10.mjs",
        "validate:final": "node tools/validate_final.mjs",
        "validate:build": "node tools/validate_build_bundle.mjs",
        "validate:character-art": "npm run validate:characters:v14",
        "validate:character-art:strict": "npm run validate:characters:v14",
        "repair:character-art": "npm run build:characters:v14",
        "build:character-art:v6": "python3 tools/build_arcade_animation_pack_v6.py && python3 tools/audit_character_sprite_packs.py --version 6 --write-metadata --strict && python3 tools/validate_arcade_animation_pack_v6.py",
        "validate:character-pack:v6": "python3 tools/validate_arcade_animation_pack_v6.py",
        "build:darya:v12": "python3 tools/build_darya_v12.py",
        "validate:darya:v12": "python3 tools/validate_darya_v12.py",
        "build:static": "npm run build && node tools/export_static.mjs",
        "build:darya:v13": "python3 tools/build_darya_v13.py",
        "validate:darya:v13": "python3 tools/validate_darya_v13.py",
        "build:characters:v14": "python3 tools/build_character_pack_v14.py && python3 tools/build_runtime_character_packs.py",
        "validate:characters:v14": "python3 tools/validate_character_pack_v14.py",
        "build:negar:v14": "python3 tools/build_character_pack_v14.py --characters negar && python3 tools/build_runtime_character_packs.py",
        "build:characters:runtime": "python3 tools/build_runtime_character_packs.py",
        "test:negar:browser": "node tools/check_negar_v14.mjs",
        "test:loading:browser": "node tools/check_loading_performance_v14.mjs",
        "import:cafe:fbx": "python3 tools/import_fbx_cafe.py sources/demian-cafe.fbx.gz.001 && python3 tools/build_fbx_cafe_layout.py && node tools/bake_fbx_cafe.mjs && python3 tools/fbx/finish_bake.py",
        "test:cafe:browser": "node tools/check_fbx_cafe.mjs",
        "validate:cafe:fbx": "node --test tests/js/fbx/FbxCafe.test.js",
        "build:ainaz:v14": "python3 tools/build_character_pack_v14.py --characters ainaz && python3 tools/build_runtime_character_packs.py --characters ainaz --report docs/release-v14-ainaz/runtime-packs.json",
        "build:arsal:v14": "python3 tools/build_character_pack_v14.py --characters arsal && python3 tools/build_runtime_character_packs.py --characters arsal --report docs/release-v14-arsal/runtime-packs.json",
        "test:arsal:browser": "node tools/check_arsal_v14.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "three": "^0.185.1"
    },
    "version": "14.0.0"
}
