# Apache/LiteSpeed static deployment configuration for the contents of _site.
# Requires AllowOverride FileInfo; check hosting support before activation.
# GitHub Pages ignores .htaccess and applies its own HTTP headers.
DirectoryIndex index.html

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set X-Frame-Options "SAMEORIGIN"

    # HTML, manifest and SW must be revalidated on every navigation/install.
    <FilesMatch "^(index|offline)\.html$">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "^(service-worker\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    </FilesMatch>

    # Content-hashed Vite JS/CSS/fonts may be cached without stale-shell risk.
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Unhashed character sprites/atlases retain normal browser HTTP caching,
    # but must revalidate on every new release to avoid stale image manifests.
    <FilesMatch "\.(json|png|webp)$">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
