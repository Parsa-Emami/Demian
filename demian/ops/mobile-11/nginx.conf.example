# Mobile-11 template (configure TLS certs and PHP-FPM version on the host).
# Do NOT place the Laravel project root or .env inside the Nginx document root.
server {
    listen 443 ssl;
    server_name api.example.com;
    root /srv/demian-api/current/public;
    index index.php;
    ssl_certificate /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 256k;
    # API host must never expose web administration routes such as /characters.
    # Only the public API and framework liveness endpoint are reachable.
    location ^~ /api/ {
        try_files $uri /index.php?$query_string;
    }
    location = /up {
        try_files $uri /index.php?$query_string;
    }
    location = /index.php {
        internal;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_read_timeout 30s;
    }
    location / { return 404; }
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known) { deny all; }
}
server {
    listen 80;
    server_name api.example.com;
    return 301 https://$host$request_uri;
}
