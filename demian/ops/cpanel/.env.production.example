# Example ONLY. Every value must be provisioned by the cPanel account owner.
APP_NAME=DemianArcade
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.demiancafe.ir
DEMIAN_ARCADE_API_ONLY=true
DEMIAN_ARCADE_ALLOWED_ORIGINS=https://demiancafe.ir
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_demian
DB_USERNAME=cpaneluser_demianapp
DB_PASSWORD=
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
LOG_CHANNEL=single
LOG_LEVEL=warning

# In-cafe staff portal requires HTTPS, persistent sessions and live DB.
DEMIAN_ARCADE_DRIFT_PRIZES_ENABLED=false
DEMIAN_COUPONS_CAFE_ENABLED=false
DEMIAN_COUPONS_WEEKLY_BUDGET_MINOR=
DEMIAN_COUPONS_CAFE_RECEIPT_HASH_KEY=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Phase 11: explicitly enabled only after supervised in-cafe UAT.
DEMIAN_COUPONS_MANUAL_GIFTS_ENABLED=false

# Step 09: new prize-bearing game verifier is disabled until explicit UAT.
DEMIAN_ARCADE_CRITTERS_RANKED_ENABLED=false

DEMIAN_ARCADE_COFFEE_RANKED_ENABLED=false

# Additional financial approval required; ranking alone never awards cafe coupons.
DEMIAN_ARCADE_CRITTERS_PRIZES_ENABLED=false
DEMIAN_ARCADE_COFFEE_PRIZES_ENABLED=false

# Step 09 route-trial modes. All remain OFF until production UAT.
# These verify a finite route challenge, not unrestricted casual gameplay.
DEMIAN_AFTER_HOURS_ROUTE_RANKED=false
DEMIAN_CAFE_RUSH_ROUTE_RANKED=false
DEMIAN_OPEN_WORLD_ROUTE_RANKED=false
# Real cafe discount eligibility is a separate sign-off, never automatic.
DEMIAN_AFTER_HOURS_ROUTE_PRIZES=false
DEMIAN_CAFE_RUSH_ROUTE_PRIZES=false
DEMIAN_OPEN_WORLD_ROUTE_PRIZES=false

# Step 32: opt-in only after legal/operator/age-policy approval and review.
DEMIAN_LEGAL_PUBLICATION_APPROVED=false
DEMIAN_LEGAL_REQUIRE_ACCEPTANCE=false

# Step 33 / private cPanel operations: only enable after log folder and cron are verified.
DEMIAN_OPS_ENABLED=false
DEMIAN_OPS_CLIENT_TELEMETRY=false
DEMIAN_OPS_SUCCESS_SAMPLE_RATE=0.2
DEMIAN_OPS_SLOW_REQUEST_MS=1500
DEMIAN_OPS_HTTP_P95_MS=1000
DEMIAN_OPS_GAME_LOAD_P95_MS=7000
DEMIAN_OPS_ERROR_RATE=0.01
DEMIAN_OPS_ALERT_EMAIL=

# Frontend build (GitHub variable, NOT a secret):
# DEMIAN_OPS_CLIENT_TELEMETRY=true only after API and notice approval.

# Phase 9: real SMS and cash-equivalent reward activation are independently OFF.
DEMIAN_PHONE_OTP_ENABLED=false
DEMIAN_PHONE_OTP_GATEWAY_URL=
DEMIAN_PHONE_OTP_GATEWAY_KEY=
DEMIAN_PRIZE_VERIFIED_PHONE_REQUIRED=false
DEMIAN_COUPONS_ISSUE_ENABLED=false
DEMIAN_COUPONS_AUTO_ISSUE_ENABLED=false
DEMIAN_WEEKLY_AUTO_AWARDS_ENABLED=false
DEMIAN_WEEKLY_MANAGEMENT_ENABLED=false
DEMIAN_WEEKLY_SETTLEMENT_ENABLED=false
DEMIAN_ARCADE_AFTER_HOURS_PRIZES_ENABLED=false
DEMIAN_ARCADE_CAFE_RUSH_PRIZES_ENABLED=false
DEMIAN_REFERRALS_ENABLED=false
DEMIAN_QUIET_HOURS_ENABLED=false
DEMIAN_QUIET_HOURS_DAILY_BUDGET_MINOR=
DEMIAN_QUIET_HOURS_COST_CEILING_BPS=
DEMIAN_QUIET_HOURS_MARGIN_FLOOR_BPS=
DEMIAN_WEB_PUSH_ENABLED=false
DEMIAN_WEB_PUSH_SUBJECT=
DEMIAN_WEB_PUSH_PUBLIC_KEY=
DEMIAN_WEB_PUSH_PRIVATE_KEY=
