# Example ONLY. Every value must be provisioned by the cPanel account owner.
APP_NAME=DemianArcade
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.example.com
DEMIAN_ARCADE_API_ONLY=true
DEMIAN_ARCADE_ALLOWED_ORIGINS=https://parsa-emami.github.io
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_demian
DB_USERNAME=cpaneluser_demianapp
DB_PASSWORD=
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
LOG_CHANNEL=single
LOG_LEVEL=warning

# In-cafe staff portal requires HTTPS, persistent sessions and live DB.
DEMIAN_COUPONS_CAFE_ENABLED=false
DEMIAN_COUPONS_CAFE_RECEIPT_HASH_KEY=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Phase 11: explicitly enabled only after supervised in-cafe UAT.
DEMIAN_COUPONS_MANUAL_GIFTS_ENABLED=false

# Step 09: new prize-bearing game verifier is disabled until explicit UAT.
DEMIAN_ARCADE_CRITTERS_RANKED_ENABLED=false

DEMIAN_ARCADE_COFFEE_RANKED_ENABLED=false

# Additional financial approval required; ranking alone never awards cafe coupons.
DEMIAN_ARCADE_CRITTERS_PRIZES_ENABLED=false
DEMIAN_ARCADE_COFFEE_PRIZES_ENABLED=false

# Step 09 route-trial modes. All remain OFF until production UAT.
# These verify a finite route challenge, not unrestricted casual gameplay.
DEMIAN_AFTER_HOURS_ROUTE_RANKED=false
DEMIAN_CAFE_RUSH_ROUTE_RANKED=false
DEMIAN_OPEN_WORLD_ROUTE_RANKED=false
# Real cafe discount eligibility is a separate sign-off, never automatic.
DEMIAN_AFTER_HOURS_ROUTE_PRIZES=false
DEMIAN_CAFE_RUSH_ROUTE_PRIZES=false
DEMIAN_OPEN_WORLD_ROUTE_PRIZES=false
