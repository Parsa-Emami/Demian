# Example ONLY. Every value must be provisioned by the cPanel account owner.
APP_NAME=DemianArcade
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=https://api-staging.example.com
DEMIAN_ARCADE_API_ONLY=true
DEMIAN_ARCADE_ALLOWED_ORIGINS=https://parsa-emami.github.io
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_demian_staging
DB_USERNAME=cpaneluser_demianapp
DB_PASSWORD=
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
LOG_CHANNEL=single
LOG_LEVEL=warning

# Phase 10 staff sessions and in-cafe redemption: disabled until UAT.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
DEMIAN_COUPONS_CAFE_ENABLED=false
DEMIAN_COUPONS_POLICY_APPROVED=false
DEMIAN_COUPONS_ISSUE_ENABLED=false
DEMIAN_COUPONS_CAFE_RECEIPT_HASH_KEY=

# Phase 11: superadmin-only gifts disabled unless approved for testing.
DEMIAN_COUPONS_MANUAL_GIFTS_ENABLED=false
