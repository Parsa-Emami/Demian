APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Coupon issuance remains disabled without a reviewed, approved shop policy.
DEMIAN_COUPONS_POLICY_APPROVED=false
DEMIAN_COUPONS_ISSUE_ENABLED=false
DEMIAN_COUPONS_AUTO_ISSUE_ENABLED=false
DEMIAN_COUPONS_SHOP_ENABLED=false
DEMIAN_COUPONS_POLICY_VERSION=
DEMIAN_COUPONS_CURRENCY=
DEMIAN_COUPONS_MIN_ORDER_MINOR=
DEMIAN_COUPONS_MAX_DISCOUNT_MINOR=
DEMIAN_COUPONS_VALID_DAYS=
# Provide independent random >=32-character secrets from a secure vault.
DEMIAN_COUPONS_SHOP_SIGNING_SECRET=
DEMIAN_COUPONS_SHOP_PREVIOUS_SIGNING_SECRET=
DEMIAN_COUPONS_ORDER_HASH_KEY=

# Cashier-only, physical cafe redemption (inactive until staging accepted).
DEMIAN_COUPONS_CAFE_ENABLED=false
# Independent secret >=32 cryptographically random chars. NEVER in Git.
DEMIAN_COUPONS_CAFE_RECEIPT_HASH_KEY=

# Phase 11: independent superadmin-only gift issuance. OFF until UAT & policy approval.
DEMIAN_COUPONS_MANUAL_GIFTS_ENABLED=false

# Step 09: new prize-bearing game verifier is disabled until explicit UAT.
DEMIAN_ARCADE_CRITTERS_RANKED_ENABLED=false

DEMIAN_ARCADE_COFFEE_RANKED_ENABLED=false

# Additional financial approval required; ranking alone never awards cafe coupons.
DEMIAN_ARCADE_CRITTERS_PRIZES_ENABLED=false
DEMIAN_ARCADE_COFFEE_PRIZES_ENABLED=false

# Step 09 route-trial modes. All remain OFF until production UAT.
# These verify a finite route challenge, not unrestricted casual gameplay.
DEMIAN_AFTER_HOURS_ROUTE_RANKED=false
DEMIAN_CAFE_RUSH_ROUTE_RANKED=false
DEMIAN_OPEN_WORLD_ROUTE_RANKED=false
# Real cafe discount eligibility is a separate sign-off, never automatic.
DEMIAN_AFTER_HOURS_ROUTE_PRIZES=false
DEMIAN_CAFE_RUSH_ROUTE_PRIZES=false
DEMIAN_OPEN_WORLD_ROUTE_PRIZES=false
